# Required. Script exits if any of these are missing or blank.
# Copy to .env and fill in real values before running.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# TigerData / TimescaleDB PostgreSQL connection URI
# Example: postgres://tsdbadmin:PASSWORD@SERVICE.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
TIGERDATA_DATABASE_URL=

# OpenFEC API key (https://api.open.fec.gov/developers/)
FEC_API_KEY=

# Optional model override (still requires GEMINI_API_KEY)
# GEMINI_MODEL=gemini-2.5-flash
