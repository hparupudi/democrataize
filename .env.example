# Shared credentials for the Python pipeline and Next.js web app.
# Copy to .env (pipeline) and/or web/.env.local (website).
# There is no demo mode — blank/placeholder values cause an immediate failure.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# TigerData / TimescaleDB PostgreSQL connection URI
# Example: postgres://tsdbadmin:PASSWORD@SERVICE.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
TIGERDATA_DATABASE_URL=

# OpenFEC API key (https://api.open.fec.gov/developers/) — required by the ingestion pipeline
FEC_API_KEY=

# ElevenLabs (https://elevenlabs.io) — required by the website voice features
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional
# GEMINI_MODEL=gemini-2.5-flash
